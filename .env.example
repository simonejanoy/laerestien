# Firebase (nettleseren): kopier til .env.local og fyll inn verdiene fra
# Firebase Console → Prosjektinnstillinger → Dine apper → Web-app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini (bare API-serveren): kopier til .env og lim inn nøkkelen fra
# https://aistudio.google.com/apikey. Uten VITE_-prefiks havner den aldri i nettleseren.
GEMINI_API_KEY=
# Porten API-serveren lytter på (valgfritt).
AI_SERVER_PORT=8787
