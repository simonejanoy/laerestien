rules_version = '2';

// Lim inn i Firebase Console → Firestore Database → Regler.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isTeacher() {
      return signedIn() && profile().role == 'teacher';
    }
    function teacherOfClass(classId) {
      return isTeacher() && profile().classId == classId;
    }

    match /users/{uid} {
      // Egen profil, eller elevene i læreren sin klasse.
      allow read: if signedIn() && (request.auth.uid == uid || teacherOfClass(resource.data.classId));

      // Lærere registrerer seg selv med riktig lærerkode (config/signup → teacherCode).
      // Lærere lager elevprofiler i sin egen klasse.
      allow create: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == 'teacher'
          && request.resource.data.teacherCode == get(/databases/$(database)/documents/config/signup).data.teacherCode)
        || (request.resource.data.role == 'student' && teacherOfClass(request.resource.data.classId))
      );

      // Læreren kan endre (f.eks. nivå) og fjerne elever i egen klasse, men ikke flytte dem.
      allow update: if resource.data.role == 'student'
        && teacherOfClass(resource.data.classId)
        && request.resource.data.role == 'student'
        && request.resource.data.classId == resource.data.classId;
      allow delete: if resource.data.role == 'student' && teacherOfClass(resource.data.classId);
    }

    // Lærerkoden: kan bare settes i Firebase Console.
    match /config/{doc} {
      allow read, write: if false;
    }

    // Økta som pågår i en klasse: alle i klassen kan lese, bare læreren kan endre.
    match /liveSessions/{classId} {
      allow read: if signedIn() && profile().classId == classId;
      allow write: if teacherOfClass(classId);
    }
  }
}
