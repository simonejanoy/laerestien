rules_version = '2';

// Lim inn i Firebase Console → Firestore Database → Regler.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isTeacher() {
      return signedIn() && profile().role == 'teacher';
    }
    function teacherOfClass(classId) {
      return isTeacher() && profile().classId == classId;
    }

    match /users/{uid} {
      // Egen profil, eller elevene i læreren sin klasse.
      allow read: if signedIn() && (request.auth.uid == uid || teacherOfClass(resource.data.classId));

      // Lærere registrerer seg selv med riktig lærerkode (config/signup → teacherCode).
      // Lærere lager elevprofiler i sin egen klasse.
      allow create: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == 'teacher'
          && request.resource.data.teacherCode == get(/databases/$(database)/documents/config/signup).data.teacherCode)
        || (request.resource.data.role == 'student' && teacherOfClass(request.resource.data.classId))
      );

      // Læreren kan endre (f.eks. nivå) og fjerne elever i egen klasse, men ikke flytte dem.
      allow update: if resource.data.role == 'student'
        && teacherOfClass(resource.data.classId)
        && request.resource.data.role == 'student'
        && request.resource.data.classId == resource.data.classId;
      allow delete: if resource.data.role == 'student' && teacherOfClass(resource.data.classId);
    }

    // Lærerkoden: kan bare settes i Firebase Console.
    match /config/{doc} {
      allow read, write: if false;
    }

    // Økta som pågår i en klasse: alle i klassen kan lese, bare læreren i klassen kan starte, pause og avslutte den.
    match /liveSessions/{classId} {
      allow read: if signedIn() && profile().classId == classId;
      allow create, update: if teacherOfClass(classId)
        && request.resource.data.status in ['running', 'paused', 'ended'];
      allow delete: if teacherOfClass(classId);

      // Elevenes framdrift i én gjennomføring av økta: hvilke oppgaver som er levert, og om de ble riktige
      // (ingen navn eller svartekst). Eleven skriver bare sitt eget dokument ({runId}__{uid}), og bare mens akkurat
      // denne gjennomføringen er i gang – etter at læreren har satt økta på pause eller avsluttet den, kan det ikke
      // leveres. Nivået må være nivået på elevens konto (når kontoen har nivå), og levert er levert: en oppgave kan
      // ikke fjernes igjen. Bare læreren i klassen kan lese. Ingenting slettes, så resultatene står igjen.
      match /progress/{docId} {
        allow read: if teacherOfClass(classId);
        allow create: if validProgress(classId, docId);
        allow update: if validProgress(classId, docId)
          && request.resource.data.delivered.keys().hasAll(resource.data.delivered.keys());
        allow delete: if false;
      }
    }

    function validProgress(classId, docId) {
      let data = request.resource.data;
      let live = get(/databases/$(database)/documents/liveSessions/$(classId)).data;
      return signedIn()
        && profile().role == 'student'
        && profile().classId == classId
        && data.studentId == request.auth.uid
        && docId == data.runId + '__' + request.auth.uid
        && data.keys().hasOnly(['studentId', 'runId', 'sessionId', 'level', 'total', 'delivered', 'updatedAt'])
        && data.keys().hasAll(['studentId', 'runId', 'sessionId', 'level', 'total', 'delivered', 'updatedAt'])
        && data.level in [1, 2, 3]
        && data.level == profile().get('level', data.level)
        && data.total is int && data.total >= 0 && data.total <= 100
        && data.delivered is map && data.delivered.size() <= 100
        && data.updatedAt is number
        && live.status == 'running'
        && live.runId == data.runId
        && live.sessionId == data.sessionId;
    }

    // Elevsvar til repetisjonen (anonyme: undertema, nivå, riktig/galt og forsøk – ingen navn eller svartekst).
    // Eleven kan bare legge til sine egne svar i sin egen klasse, ikke lese, endre eller slette dem.
    // Bare læreren i klassen kan lese dem.
    match /results/{classId}/answers/{answerId} {
      allow read: if teacherOfClass(classId);
      allow create: if signedIn()
        && profile().role == 'student'
        && profile().classId == classId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.keys().hasOnly(['studentId', 'sessionId', 'topicId', 'skill', 'level', 'taskType', 'correct', 'attempts', 'at'])
        && request.resource.data.level in [1, 2, 3]
        && request.resource.data.correct is bool
        && request.resource.data.attempts is int && request.resource.data.attempts >= 1 && request.resource.data.attempts <= 5;
      allow update, delete: if false;
    }
  }
}
